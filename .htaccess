# NEW: Tell the server to use your custom 404 page
ErrorDocument 404 /404.php


<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't apply rules to existing files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirect all other requests to index.php
    RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>


# --- Section 3: Security Enhancements ---
# These rules help protect your site from common vulnerabilities.

# Prevent people from browsing your file directories.
Options -Indexes

# Block access to sensitive files that might contain configuration details or logs.
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent direct access to the 'includes' and 'admin' folders from a web browser.
# Users should only access pages through your main index.php router.
# RewriteRule ^(includes|admin)/ - [F,L]


# --- Section 4: Performance (Browser Caching) ---
# This tells browsers to store static files (like images and CSS) for a long time,
# which makes the site load faster for repeat visitors.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>